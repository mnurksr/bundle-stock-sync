// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Shopify Session (Default) ──────────────────────────────────────────────────

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─── Shop — Installed store info & plan tracking ────────────────────────────────

model Shop {
  id            String    @id @default(cuid())
  shopDomain    String    @unique // e.g. "my-store.myshopify.com"
  plan          String    @default("free") // "free" | "pro"
  syncCount     Int       @default(0) // Current period sync count
  syncResetDate DateTime? // When the quota was last reset
  isActive      Boolean   @default(true)
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bundleRules BundleRule[]
  syncLogs    SyncLog[]
}

// ─── BundleRule — Links a bundle/multipack variant to multiple base/master variants ─────

model BundleRule {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Bundle (Multipack) product info
  bundleProductId    String // Shopify Product GID
  bundleVariantId    String // Shopify ProductVariant GID
  bundleProductTitle String // Display name
  bundleSku          String? // Bundle SKU

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    BundleItem[]
  syncLogs SyncLog[]

  @@unique([shopId, bundleVariantId]) // One variant can only be in one bundle rule per shop
  @@index([shopId])
  @@index([bundleVariantId])
}

model BundleItem {
  id String @id @default(cuid())

  bundleRuleId String
  bundleRule   BundleRule @relation(fields: [bundleRuleId], references: [id], onDelete: Cascade)

  // Base (Master/Single) product info
  baseProductId       String // Shopify Product GID
  baseVariantId       String // Shopify ProductVariant GID
  baseProductTitle    String // Display name
  baseSku             String? // Base product SKU
  baseInventoryItemId String // Shopify InventoryItem GID — used for stock adjustment

  quantity Int @default(1) // Number of base items in this bundle

  @@index([bundleRuleId])
  @@index([baseVariantId])
}

// ─── SyncLog — Record of every inventory adjustment ─────────────────────────────

model SyncLog {
  id String @id @default(cuid())

  shopId       String
  shop         Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bundleRuleId String?
  bundleRule   BundleRule? @relation(fields: [bundleRuleId], references: [id], onDelete: SetNull)

  orderId   String // Shopify Order GID
  orderName String // e.g. "#1001"

  bundleVariantId String

  // JSON summary of the items deducted: e.g. [{"baseVariantId": "...", "title": "Coffee", "quantitySold": 1, "multiplier": 2, "totalAdjustment": 2}]
  itemsSummary String

  status       String  @default("pending") // "pending" | "success" | "failed" | "skipped"
  errorMessage String? // Error details if failed

  idempotencyKey String    @unique // Prevents duplicate processing
  processedAt    DateTime? // When the adjustment was completed

  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}
